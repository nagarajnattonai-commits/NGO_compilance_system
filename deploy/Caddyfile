{
    email {$ACME_EMAIL}
    on_demand_tls {
        ask http://api:8000/api/v1/white-label/domain-authorization
    }
}

(application) {
    # This gate is internal to the certificate issuer, never a public route.
    @internal path /api/v1/white-label/domain-authorization
    respond @internal 404
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy web:3000
}

{$PLATFORM_DOMAIN} {
    import application
}

https:// {
    tls {
        on_demand
    }
    import application
}

http:// {
    redir https://{host}{uri} permanent
}
