PLATFORM_DOMAIN=app.your-platform.in
WHITE_LABEL_CNAME_TARGET=edge.your-platform.in
ACME_EMAIL=operations@your-platform.in
PLATFORM_ADMIN_EMAILS=operator@your-platform.in
# Generate a random shared value >=32 characters. Never use this placeholder.
BRAND_PROXY_KEY=
# URL-safe random password, or percent-encode reserved URL characters in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=10
RELEASE_VERSION=0.25.0
BUILD_SHA=development
BRAND_S3_BUCKET=
BRAND_S3_ENDPOINT=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ENDPOINT=
DOCUMENT_SCAN_REQUIRED=false
AWS_REGION=ap-south-1
# Prefer workload identity/IAM where your deployment supports it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Must be verified by the platform email provider; tenants cannot change From.
SMTP_FROM=
